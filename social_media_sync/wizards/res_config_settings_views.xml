<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.social.media.sync</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="mail.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//block[@id='emails']" position="inside">
        <setting id="social_media_sync_media_retention" string="Social Media">
          <field name="social_media_sync_media_max_age_days" />
          <div class="content-group">
            <label for="social_media_sync_media_max_age_days" />
            <div
                            class="text-muted"
                            id="social_media_sync_media_max_age_days"
                        >If set as a positive integer, the images and videos downloaded from the social media are released from the publications older than that, and the files are removed by the vacuum. What each social media made of them is kept, so the publications are not downloaded again.</div>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
